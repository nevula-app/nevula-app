EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-nevula-publishable-key
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://nevula.de/delete
EXPO_PUBLIC_PRIVACY_URL=https://nevula.de/privacy
EXPO_PUBLIC_SUPPORT_URL=https://nevula.de/support
EXPO_PUBLIC_COMMUNITY_URL=https://nevula.de/community
EXPO_PUBLIC_DELETE_URL=https://nevula.de/delete
EXPO_PUBLIC_IMPRINT_URL=https://nevula.de/imprint
# Optional: Expo project UUID if using ExponentPushToken (otherwise native FCM device token is used).
# EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets), not in the app ---
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# NOTIFY_PUSH_HOOK_SECRET=optional-shared-secret-for-db-webhooks

# Website (Vite / Cloudflare): put these in legal-site/.env.local, not the app env.
# Copy only this section for local website development. Use your own Cloudflare resources.
# The all-zero database UUID is a local-development placeholder; replace before deployment.
SUPABASE_URL=https://your-project.supabase.co
NEVULA_SITE_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
NEVULA_SITE_D1_DATABASE_NAME=community-db
NEVULA_SITE_WORKER_NAME=community-site
# Optional R2 bucket; unset disables the R2 binding. No Sites project ID is required.
# NEVULA_SITE_R2_BUCKET_NAME=your-bucket-name
# Cloudflare credentials stay in your login/environment; never commit them here.
